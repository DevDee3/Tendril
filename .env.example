# FalkorDB connection, read by lib/falkordb-client.js
# Defaults (127.0.0.1:6379) match `docker compose up -d` — only override
# these if you're pointing at FalkorDB Cloud or a non-default setup.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
TENDRIL_API_TOKEN=replace-with-a-long-random-token
# Optional comma-separated tokens allow zero-downtime token rotation.
# TENDRIL_API_TOKENS=old-token,new-token
TENDRIL_ALLOWED_ORIGINS=http://localhost:3001
TENDRIL_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
# Only needed if your FalkorDB instance requires auth (e.g. Cloud):
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Name of the shared memory graph used by agent/memory.js (Track 02).
# Leave unset to use the default.
# FALKORDB_MEMORY_GRAPH=tendril_memory

# Run node scripts with the env file loaded, e.g.:
#   node --env-file=.env agent/agent.js ingest/fixtures/VulnerableVault.sol tendril
