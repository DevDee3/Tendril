# Used by script/Deploy.s.sol and foundry.toml's [rpc_endpoints]/[etherscan]

# --- Local anvil (default, works out of the box) ---
RPC_URL=http://127.0.0.1:8545
# anvil's well-known test account #0 — test funds only, printed by anvil
# itself on startup, never use it anywhere real
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Sepolia (optional) ---
# An RPC URL from a provider (Alchemy, Infura, etc). foundry.toml references
# this as the `sepolia` named network via [rpc_endpoints].
SEPOLIA_RPC_URL=
# A throwaway wallet's private key, funded from a Sepolia faucet. Never a
# key that holds real funds, on any chain.
# PRIVATE_KEY=0x...

# Optional: only needed for `forge script --verify` on Sepolia
ETHERSCAN_API_KEY=

# Optional: who gets the priceOracle role. Defaults to the deployer if unset.
# ORACLE_ADDRESS=

# Usage:
#   # local anvil (run `anvil` first, in another terminal):
#   forge script script/Deploy.s.sol --rpc-url $RPC_URL --private-key $PRIVATE_KEY --broadcast
#
#   # sepolia — first remove the `solc`/`offline` lines from foundry.toml
#   # (those exist only for this project's own sandboxed dev environment):
#   forge script script/Deploy.s.sol --rpc-url sepolia --private-key $PRIVATE_KEY --broadcast --verify
